# NovaBrief — example environment file
# Copy this to ".env" (same folder as app.py) and fill in real values.
# .env is already in .gitignore — it will not be committed.
# Auto-loaded at startup if the optional "python-dotenv" package is
# installed (pip install python-dotenv); plain OS environment variables
# work too either way, .env is just a convenience.

# ── MySQL ─────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=NovaAiSummary

# ── Flask session secret — generate with: ──────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value

# ── Admin panel (comma-separated emails) ───────────
NOVABRIEF_ADMIN_EMAILS=you@example.com

# ── CORS (comma-separated origins allowed to send credentials) ─────
NOVABRIEF_CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Everything else below is optional — see config.py for the full list
# and defaults (AI models, timeouts, cache expiry, etc.)
# NOVABRIEF_MODEL=sshleifer/distilbart-cnn-12-6
# NOVABRIEF_WHISPER_MODEL=small
# NOVABRIEF_FORCE_CPU=false
